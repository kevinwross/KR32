      "cacheVariables": {
        "KR32_BUILD_UI": "ON",
        "KR32_BUILD_TESTS": "ON",
        "KR32_BUILD_OS_IMAGES": "ON",
        "SDL2_DIR": "${sourceDir}/third_party/SDL2/cmake"
      }
    },
    {
